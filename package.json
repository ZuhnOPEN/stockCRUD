{
  "name": "stockcrud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix server run start",
    "test:selenium": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.selenium.js",
    "test:selenium:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.selenium.js --watch",
    "test:selenium:ui": "HEADLESS=false NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.selenium.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "chromedriver": "^152.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "geckodriver": "^6.1.1",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.74.0",
    "prettier": "3.9.5",
    "selenium-webdriver": "^4.47.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
