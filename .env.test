# Configuración para tests de Selenium
BASE_URL=http://localhost:5173
API_URL=http://localhost:4000/api

# Navegador a usar: 'chrome' o 'firefox' (default: firefox)
BROWSER=firefox

# Modo headless (true/false)
HEADLESS=true

# Credenciales de prueba (serán generadas dinámicamente)
# TEST_EMAIL=qa_test@test.com
# TEST_PASSWORD=TestPassword123!

# Timeouts (ms)
IMPLICIT_WAIT=8000
TIMEOUT=10000
